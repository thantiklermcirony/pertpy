+    manifest = json.loads(json.dumps(scores.attrs["pertpy_evaluation"]))
+    assert manifest["feature_sets"] == [{"group": ["A+B"], "features": ["g0", "g1"]}]
+    assert manifest["train_cell_ids_sha256"] != manifest["test_cell_ids_sha256"]
